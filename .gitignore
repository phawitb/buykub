# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# isolated development worktrees
/.worktrees/

# local Supabase CLI link metadata
/supabase/.temp/

# local image-source research
/.firecrawl/

# Private operational backups; never deploy or commit customer records
/.private-backups/

# Vendored agent skills (installed with npx; reinstall rather than commit)
/.agents/
/.claude/skills/
/.claude/agents/

# Agent skill lockfile; the skills themselves are vendored and reinstallable
/skills-lock.json

# Impeccable: keep the reviewed ignore decisions, drop the local detector cache
/.impeccable/hook.cache.json

# OCR runtime copied out of node_modules by scripts/copy-ocr-assets.mjs;
# the Thai model beside it is committed because no package ships it.
/public/ocr/*
!/public/ocr/tha.traineddata
